# Build configuration for the admin dashboard (admin subdomain)
# Loaded automatically by `vite --mode admin`.
VITE_BUILD_TARGET=admin

# Strict gate: redirects unauthenticated users to /login, and shows
# "Admin access required" if signed in but profile.is_admin is false.
# Requires:
#   1. supabase/migrations/20260521_admin_role.sql has been run
#   2. Your account has `is_admin = true` in customer_profiles
#   3. VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY set in Vercel
VITE_ENFORCE_ADMIN_AUTH=true
