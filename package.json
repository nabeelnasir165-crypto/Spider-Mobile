{
  "name": "spider-mobile-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev":       "cross-env BROWSER=chrome vite --port 5173 --strictPort --open /",
    "dev:site":  "cross-env BROWSER=chrome vite --mode site  --port 5173 --strictPort --open /",
    "dev:admin": "cross-env BROWSER=chrome vite --mode admin --port 5180 --strictPort --open /admin",
    "dev:both":  "concurrently -n site,admin -c cyan,magenta \"npm:dev:site\" \"npm:dev:admin\"",
    "build":       "vite build",
    "build:site":  "vite build --mode site",
    "build:admin": "vite build --mode admin",
    "build:both":  "npm run build:site && npm run build:admin",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  }
}
